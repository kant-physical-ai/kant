<?xml version="1.0"?>
<robot name="quadruped">

    <!-- ================================================= -->
    <!-- 12-DOF Quadruped Robot URDF                       -->
    <!-- Clean, verified structure with no duplicate/broken links -->
    <!-- ================================================= -->

    <!-- Base Footprint -->
    <link name="base_footprint"/>

    <!-- Main Trunk (Body) -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.45 0.20 0.10"/>
            </geometry>
            <material name="body_mat">
                <color rgba="0.8 0.8 0.8 1.0"/>
            </material>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.35" rpy="0 0 0"/>
    </joint>

    <!-- Head -->
    <link name="head">
        <visual>
            <geometry>
                <box size="0.12 0.10 0.10"/>
            </geometry>
            <material name="head_mat">
                <color rgba="0.2 0.2 0.2 1.0"/>
            </material>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>

    <joint name="head_joint" type="fixed">
        <parent link="base_link"/>
        <child link="head"/>
        <origin xyz="0.26 0 0.03" rpy="0 0 0"/>
    </joint>

    <!-- Tail -->
    <link name="tail">
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.15"/>
            </geometry>
            <material name="tail_mat">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
            <origin xyz="0 0 -0.075" rpy="0 0 0"/>
        </visual>
    </link>

    <joint name="tail_joint" type="revolute">
        <parent link="base_link"/>
        <child link="tail"/>
        <origin xyz="-0.23 0 0.03" rpy="0 0.5 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.78" upper="0.78" effort="5" velocity="2"/>
    </joint>

    <!-- ================= FL Leg (Front Left) ================= -->
    <link name="FL_hip">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
    </link>
    <joint name="FL_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="FL_hip"/>
        <origin xyz="0.15 0.12 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.78" upper="0.78" effort="20" velocity="5"/>
    </joint>

    <link name="FL_thigh">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.18"/>
            </geometry>
            <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="FL_thigh_joint" type="revolute">
        <parent link="FL_hip"/>
        <child link="FL_thigh"/>
        <origin xyz="0 0.04 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="30" velocity="5"/>
    </joint>

    <link name="FL_calf">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.18"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="FL_calf_joint" type="revolute">
        <parent link="FL_thigh"/>
        <child link="FL_calf"/>
        <origin xyz="0 0 -0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6" upper="-0.5" effort="30" velocity="5"/>
    </joint>

    <!-- ================= FR Leg (Front Right) ================= -->
    <link name="FR_hip">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
    </link>
    <joint name="FR_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="FR_hip"/>
        <origin xyz="0.15 -0.12 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.78" upper="0.78" effort="20" velocity="5"/>
    </joint>

    <link name="FR_thigh">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.18"/>
            </geometry>
            <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="FR_thigh_joint" type="revolute">
        <parent link="FR_hip"/>
        <child link="FR_thigh"/>
        <origin xyz="0 -0.04 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="30" velocity="5"/>
    </joint>

    <link name="FR_calf">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.18"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="FR_calf_joint" type="revolute">
        <parent link="FR_thigh"/>
        <child link="FR_calf"/>
        <origin xyz="0 0 -0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6" upper="-0.5" effort="30" velocity="5"/>
    </joint>

    <!-- ================= RL Leg (Rear Left) ================= -->
    <link name="RL_hip">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
    </link>
    <joint name="RL_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="RL_hip"/>
        <origin xyz="-0.15 0.12 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.78" upper="0.78" effort="20" velocity="5"/>
    </joint>

    <link name="RL_thigh">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.18"/>
            </geometry>
            <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="RL_thigh_joint" type="revolute">
        <parent link="RL_hip"/>
        <child link="RL_thigh"/>
        <origin xyz="0 0.04 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="30" velocity="5"/>
    </joint>

    <link name="RL_calf">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.18"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="RL_calf_joint" type="revolute">
        <parent link="RL_thigh"/>
        <child link="RL_calf"/>
        <origin xyz="0 0 -0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6" upper="-0.5" effort="30" velocity="5"/>
    </joint>

    <!-- ================= RR Leg (Rear Right) ================= -->
    <link name="RR_hip">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.05"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
    </link>
    <joint name="RR_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="RR_hip"/>
        <origin xyz="-0.15 -0.12 0" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.78" upper="0.78" effort="20" velocity="5"/>
    </joint>

    <link name="RR_thigh">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.18"/>
            </geometry>
            <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="RR_thigh_joint" type="revolute">
        <parent link="RR_hip"/>
        <child link="RR_thigh"/>
        <origin xyz="0 -0.04 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="30" velocity="5"/>
    </joint>

    <link name="RR_calf">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.18"/>
            </geometry>
            <material name="dark"><color rgba="0.3 0.3 0.3 1.0"/></material>
            <origin xyz="0 0 -0.09" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="RR_calf_joint" type="revolute">
        <parent link="RR_thigh"/>
        <child link="RR_calf"/>
        <origin xyz="0 0 -0.18" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.6" upper="-0.5" effort="30" velocity="5"/>
    </joint>

</robot>